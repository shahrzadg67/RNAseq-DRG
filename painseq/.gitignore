# painseq — what is NOT committed.
#
# Everything excluded here is either a large public input (re-downloadable from GEO)
# or a regenerable intermediate. The scripts in analysis/ rebuild all of it:
#   bash scripts/run_analysis.sh all     # 01..05
#   bash scripts/run_stage2.sh           # export + scanpy QC/UMAP
#   Rscript analysis/40_extract_percell.R ... 47_minp_beyond_injury.R
#
# deploy/push_source.sh in the parent project honours this file via rsync --filter,
# so this is the single place to change what ships.

# ---- raw GEO downloads (public: GSE154659) ----------------------------------
*.RDS.gz

# ---- environments and caches -------------------------------------------------
.venv-sc/
.cache/
logs/

# ---- large intermediates -----------------------------------------------------
# AnnData objects and the binary CSC export handed to scanpy (~1.8 GB)
data/*.h5ad
data/export_*/

# per-cell UMAP tables (22.5 MB + 2.9 MB); regenerated by 11_qc_umap.py
data/umap_*.csv

# pseudobulk and per-cell matrices (2.8-34.7 MB each)
data/pb_*.rds
data/panel_celltype_fits.rds
data/panel_timecourse.rds
data/percell_expr*.rds
data/percell_app.rds

# ---- figures -----------------------------------------------------------------
# PNGs are committed so the results are readable on GitHub; the PDF twins are
# byte-for-byte regenerable and add ~39 MB.
figs/*.pdf

# ---- misc --------------------------------------------------------------------
.Rhistory
.RData
*.pid
