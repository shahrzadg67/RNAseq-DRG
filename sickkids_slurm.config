// Custom config for nf-core/rnaseq on the SickKids HPC (Slurm + Singularity).
// No institutional nf-core profile exists for this cluster, so we define one here.

params {
    config_profile_name        = 'sickkids_ccm'
    config_profile_description = 'SickKids CCM HPC (Slurm, Singularity) - lab msalter'
}

process {
    executor       = 'slurm'
    queue          = 'general'
    // Slurm account. If the 'general' partition rejects the job for a missing/
    // wrong QOS, add e.g. ' --qos=<normal_qos>' here (see smoke-test note).
    clusterOptions = '--account=msalter'

    // Run tasks in the work dir on shared /hpf/projects (1.3 TB free). We do NOT
    // use node-local scratch: without a guaranteed --tmp the nodes' default /tmp
    // is tiny and large fastq tasks overflow it ("No space left on device").
    scratch        = false

    // Ceilings so nf-core's per-process requests never exceed a 'general' node.
    resourceLimits = [ cpus: 32, memory: 180.GB, time: 72.h ]
}

executor {
    queueSize       = 50          // max concurrent Slurm jobs from this run
    submitRateLimit = '10/1min'   // be polite to the scheduler
}

singularity {
    enabled    = true
    autoMounts = true
    // cacheDir is taken from $NXF_SINGULARITY_CACHEDIR (set in run_rnaseq.sh).
}

// Keep a clean record of resource usage / timeline for tuning future runs.
timeline { enabled = true }
report   { enabled = true }
trace    { enabled = true }
